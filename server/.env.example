PORT=3000
NODE_ENV=development

# PostgreSQL connection (docker-compose default below)
DATABASE_URL=postgresql://foundit:foundit123@localhost:5432/foundit

# JWT secrets — generate strong random values for production
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS allowlist (comma-separated). Empty = allow all (dev default). Set in production, e.g.:
# ALLOWED_ORIGINS=http://localhost:5173,https://foundit.example.com
ALLOWED_ORIGINS=

# First super admin (seeded automatically on boot if missing)
SUPER_ADMIN_EMAIL=superadmin@foundit.local
SUPER_ADMIN_PASSWORD=SuperAdmin123!
SUPER_ADMIN_NAME=Super Admin

# Seed demo admin@foundit.local / user@foundit.local (passwords: Admin123! / User12345!)
SEED_DEMO_USERS=true
